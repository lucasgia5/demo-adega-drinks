# Ambiente: use development localmente e production no Render/Railway.
APP_ENV=development

# MongoDB Atlas em produção. Use uma connection string copiada do Atlas.
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=store_white_label

# Gere um segredo forte e único por loja. Nunca reutilize entre projetos.
JWT_SECRET=replace-with-a-random-64-character-secret

# Admin semeado/atualizado no startup. Use senha forte e única por loja.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# URL HTTPS pública do frontend em produção. Pode conter múltiplas URLs separadas por vírgula.
FRONTEND_URL=http://localhost:3000

# Cloudinary. Nunca commite credenciais reais.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
